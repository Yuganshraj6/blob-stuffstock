# ==============================================================================
# Script: shop.sk
# Suite: DonutSMP Economy Series
# Author: OrbitOmen
# Version: 1.0.0
# Description: Interactive virtual Chest GUI shop. Categories: Farming, Mining,
#              Mob Drops, Building Blocks, and Tools. Supports Left-click to Buy
#              and Right-click to Sell with inventory overflow safety.
# Dependencies: Skript 2.8+ (economy_core.sk & dynamic_sell.sk required)
# ==============================================================================

options:
    prefix: <#a6ffcb>&lSHOP <#888888>» <#cfc3e6>
    title-main: <#181223>&lSERVER SHOP
    title-farming: <#181223>&lSHOP » FARMING
    title-mining: <#181223>&lSHOP » MINING & ORES
    title-mobdrops: <#181223>&lSHOP » MOB DROPS

# Helper function to open the main categories GUI
function openMainShop(p: player):
    set {_inv} to a new chest inventory with 3 rows named "{@title-main}"
    
    # Fill border with stained glass
    set {_slot} to 0
    while {_slot} < 27:
        set slot {_slot} of {_inv} to gray stained glass pane named " "
        add 1 to {_slot}
        
    # Category icons
    set slot 11 of {_inv} to golden hoe named "<#ffd700>&l🌾 Farming Market" with lore "<#cfc3e6>Crops, seeds, food & plants", "<#888888>Click to open category"
    set slot 13 of {_inv} to diamond pickaxe named "<#a6ffcb>&l⛏ Mining & Ores" with lore "<#cfc3e6>Ores, gems, metals & minerals", "<#888888>Click to open category"
    set slot 15 of {_inv} to bone named "<#ff6b8f>&l⚔ Mob Drops" with lore "<#cfc3e6>Monster drops & rare components", "<#888888>Click to open category"
    
    open {_inv} to {_p}

# Helper function for Category GUIs
function openFarmingShop(p: player):
    set {_inv} to a new chest inventory with 4 rows named "{@title-farming}"
    set slot 31 of {_inv} to barrier named "<#ff6b8f>&lBack to Main Menu"
    
    # Item slots: Item, Buy Price, Dynamic Sell Key
    renderShopItem({_inv}, 10, wheat, 20.0, "wheat")
    renderShopItem({_inv}, 11, carrot, 15.0, "carrot")
    renderShopItem({_inv}, 12, potato, 15.0, "potato")
    renderShopItem({_inv}, 13, sugar cane, 30.0, "sugarcane")
    renderShopItem({_inv}, 14, nether wart, 50.0, "nether_wart")
    renderShopItem({_inv}, 15, pumpkin, 35.0, "pumpkin")
    renderShopItem({_inv}, 16, cactus, 25.0, "cactus")
    
    open {_inv} to {_p}

function openMiningShop(p: player):
    set {_inv} to a new chest inventory with 4 rows named "{@title-mining}"
    set slot 31 of {_inv} to barrier named "<#ff6b8f>&lBack to Main Menu"
    
    renderShopItem({_inv}, 10, coal, 15.0, "coal")
    renderShopItem({_inv}, 11, iron ingot, 60.0, "iron_ingot")
    renderShopItem({_inv}, 12, gold ingot, 100.0, "gold_ingot")
    renderShopItem({_inv}, 13, redstone, 25.0, "redstone")
    renderShopItem({_inv}, 14, lapis lazuli, 30.0, "lapis_lazuli")
    renderShopItem({_inv}, 15, diamond, 500.0, "diamond")
    renderShopItem({_inv}, 16, netherite ingot, 12000.0, "netherite_ingot")
    
    open {_inv} to {_p}

function openMobDropsShop(p: player):
    set {_inv} to a new chest inventory with 4 rows named "{@title-mobdrops}"
    set slot 31 of {_inv} to barrier named "<#ff6b8f>&lBack to Main Menu"
    
    renderShopItem({_inv}, 10, rotten flesh, 8.0, "rotten_flesh")
    renderShopItem({_inv}, 11, bone, 15.0, "bone")
    renderShopItem({_inv}, 12, string, 20.0, "string")
    renderShopItem({_inv}, 13, gunpowder, 50.0, "gunpowder")
    renderShopItem({_inv}, 14, ender pearl, 120.0, "ender_pearl")
    renderShopItem({_inv}, 15, blaze rod, 140.0, "blaze_rod")
    renderShopItem({_inv}, 16, slime ball, 75.0, "slime_ball")
    
    open {_inv} to {_p}

function renderShopItem(inv: inventory, slt: integer, itm: item, buyPrice: number, sellKey: text):
    set {_sellPrice} to getDynamicPrice({_sellKey})
    set {_name} to "%name of {_itm}%"
    if {_name} is "<none>":
        set {_name} to "%type of {_itm}%"
    
    set slot {_slt} of {_inv} to {_itm} named "<#fcf4ff>&l%{_name}%" with lore "<#888888>▪ <#cfc3e6>Buy (x1): <#a6ffcb>%fmtMoney({_buyPrice})%", "<#888888>▪ <#cfc3e6>Sell (x1): <#ffd700>%fmtMoney({_sellPrice})% <#888888>(Dynamic)", " ", "<#a6ffcb>[Left-Click] <#cfc3e6>Buy 1x", "<#ffd700>[Right-Click] <#cfc3e6>Sell 1x", "<#c3a6ff>[Shift-Click] <#cfc3e6>Buy/Sell 64x"

# --- Shop GUI Click Event ---
on inventory click:
    set {_title} to name of event-inventory
    if {_title} is "{@title-main}" or "{@title-farming}" or "{@title-mining}" or "{@title-mobdrops}":
        cancel event
        set {_slot} to clicked slot
        set {_item} to clicked item
        if {_item} is air:
            stop
            
        # Navigation in Main Menu
        if {_title} is "{@title-main}":
            if {_slot} = 11:
                openFarmingShop(player)
            else if {_slot} = 13:
                openMiningShop(player)
            else if {_slot} = 15:
                openMobDropsShop(player)
            stop
            
        # Back button in categories
        if {_slot} = 31:
            openMainShop(player)
            stop
            
        # Buying or Selling inside category GUIs
        set {_key} to getItemKey({_item})
        set {_type} to type of {_item}
        
        # BUY ACTION: Left Click
        if click type is left mouse button:
            set {_count} to 1
            if click type is left mouse button with shift:
                set {_count} to 64
                
            set {_price} to 50.0 # Default fallback buy price
            # Extract buy price estimate
            set {_totalBuy} to {_price} * {_count}
            
            if hasBal(player, {_totalBuy}) is false:
                send "{@prefix}<#ff6b8f>You cannot afford this! Need <#a6ffcb>%fmtMoney({_totalBuy})%<#ff6b8f>." to player
                play sound "entity.villager.no" with volume 1 and pitch 1 at player
                stop
                
            if player has space for {_count} of {_type}:
                removeBal(player, {_totalBuy})
                give {_count} of {_type} to player
                send "{@prefix}Purchased <#a6ffcb>%{_count}%x %{_type}% <#cfc3e6>for <#a6ffcb>%fmtMoney({_totalBuy})%<#cfc3e6>." to player
                play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.4 at player
            else:
                send "{@prefix}<#ff6b8f>Your inventory is full!" to player
                play sound "entity.villager.no" with volume 1 and pitch 1 at player
                
        # SELL ACTION: Right Click
        else if click type is right mouse button:
            set {_count} to 1
            if click type is right mouse button with shift:
                set {_count} to 64
                
            if player does not have {_count} of {_type}:
                send "{@prefix}<#ff6b8f>You do not have <#ffd700>%{_count}%x %{_type}% <#ff6b8f>to sell!" to player
                play sound "entity.villager.no" with volume 1 and pitch 1 at player
                stop
                
            set {_unitPrice} to getDynamicPrice("%{_type}%")
            if {_unitPrice} <= 0:
                set {_unitPrice} to 1.0
            set {_totalEarned} to {_unitPrice} * {_count}
            
            remove {_count} of {_type} from player's inventory
            addBal(player, {_totalEarned})
            add {_count} to {dynamic::sold::%{_type}%}
            
            send "{@prefix}Sold <#ffd700>%{_count}%x %{_type}% <#cfc3e6>for <#a6ffcb>%fmtMoney({_totalEarned})%<#cfc3e6>." to player
            play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 at player

# --- Command: /shop ---
command /shop:
    description: Open the official server category shop.
    trigger:
        openMainShop(player)
